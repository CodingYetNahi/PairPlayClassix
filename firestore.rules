rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access to unlisted collections
    match /{document=**} {
      allow read, write: if false;
    }

    // PairPlay Rooms Collection
    match /rooms/{roomCode} {
      // Helper functions
      function isSignedIn() {
        return request.auth != null && request.auth.uid != null;
      }

      function isRoomHost() {
        return isSignedIn() && resource.data.hostUid == request.auth.uid;
      }

      function isRoomGuest() {
        return isSignedIn() && resource.data.guestUid == request.auth.uid;
      }

      function isRoomMember() {
        return isRoomHost() || isRoomGuest();
      }

      function isValidRoomCode() {
        return roomCode.size() == 6;
      }

      function identitiesAreImmutable() {
        return request.resource.data.roomCode == resource.data.roomCode
          && request.resource.data.hostUid == resource.data.hostUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.player1.id == resource.data.player1.id
          && request.resource.data.player1.name == resource.data.player1.name
          && request.resource.data.player1.avatar == resource.data.player1.avatar
          && request.resource.data.guestUid == resource.data.guestUid
          && (resource.data.guestUid == null || (
            request.resource.data.player2.id == resource.data.player2.id
            && request.resource.data.player2.name == resource.data.player2.name
            && request.resource.data.player2.avatar == resource.data.player2.avatar));
      }

      function hostOnlyTransitionIsValid() {
        let selectedGame = request.resource.data.currentGameId != resource.data.currentGameId;
        let returnedToLobby = request.resource.data.status == 'lobby' && resource.data.status != 'lobby';
        let rematched = resource.data.status == 'game_over' && request.resource.data.status == 'playing';
        return !(selectedGame || returnedToLobby || rematched) || isRoomHost();
      }

      function scoreAndRoundChangeIsBounded() {
        let hostReset = isRoomHost()
          && (request.resource.data.currentGameId != resource.data.currentGameId
            || (resource.data.status == 'game_over' && request.resource.data.status == 'playing'));
        return hostReset || (
          request.resource.data.currentRound >= resource.data.currentRound
          && request.resource.data.currentRound <= resource.data.currentRound + 1
          && request.resource.data.score1 >= resource.data.score1
          && request.resource.data.score1 <= resource.data.score1 + 1
          && request.resource.data.score2 >= resource.data.score2
          && request.resource.data.score2 <= resource.data.score2 + 1);
      }

      // Read rules:
      // 1. A signed-in user can fetch an individual room doc by room code to join.
      // 2. Room listing queries (listing all rooms) are strictly denied.
      allow get: if isSignedIn() && isValidRoomCode();
      allow list: if false;

      // Create rules:
      // Must be signed in, roomCode must be 6 chars, creator must be hostUid
      allow create: if isSignedIn()
        && isValidRoomCode()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.roomCode == roomCode
        && request.resource.data.player1.name is string
        && request.resource.data.player1.name.size() <= 25
        && request.resource.data.player1.name.size() >= 1;

      // Update rules:
      // Either:
      // 1. An existing room member (host or guest) updating game state / heartbeat / leaving
      // 2. A new guest joining an empty guest slot (guestUid == null -> guestUid == request.auth.uid)
      allow update: if isSignedIn() && (
        // Case A: Room Member modifying game
        (isRoomMember()
          && identitiesAreImmutable()
          && hostOnlyTransitionIsValid()
          && scoreAndRoundChangeIsBounded())
        ||
        // Case B: Joining as guest into empty slot
        (
          resource.data.guestUid == null
          && request.resource.data.guestUid == request.auth.uid
          && request.resource.data.hostUid == resource.data.hostUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guestUid', 'player2', 'lastActiveAt'])
          && request.resource.data.player2.name is string
          && request.resource.data.player2.name.size() <= 25
        )
      );

      // Delete rules:
      // Only the host can delete the room document
      allow delete: if isRoomHost();
    }
  }
}
